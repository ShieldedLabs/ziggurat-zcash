# The release asset URL of the mempool-listener binary.
RELEASE_URL=https://github.com/OWNER/REPO/releases/download/mempool-v0.1.0/mempool-listener-x86_64-linux
# The VPS address on the VPC. Prometheus scrapes port 9101 there.
VPC_IP=10.0.0.10
# The listener's ntfy token (write-only on the mempool topic).
NTFY_LISTENER_TOKEN=
